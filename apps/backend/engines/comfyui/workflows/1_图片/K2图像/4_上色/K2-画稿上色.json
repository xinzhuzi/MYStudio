t"},"link":6},{"localized_name":"批量大小","name":"batch_size","type":"INT","widget":{"name":"batch_size"},"link":null}],"outputs":[{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[12,20]}],"title":"[9] 空latent(生成尺寸)","properties":{"Node name for S&R":"EmptySD3LatentImage","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{"width":true,"height":true,"batch_size":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[1024,1024,1],"widgets_values_named":{"width":1024,"height":1024,"batch_size":1},"color":"#233","bgcolor":"#355"},{"id":16,"type":"GetImageSize+","pos":[423.2516878118629,679.412993326372],"size":[225,98],"flags":{"collapsed":false},"order":14,"mode":0,"inputs":[{"label":"图像","localized_name":"image","name":"image","type":"IMAGE","link":21}],"outputs":[{"label":"宽度","localized_name":"width","name":"width","type":"INT","links":[5]},{"label":"高度","localized_name":"height","name":"height","type":"INT","links":[6]},{"localized_name":"count","name":"count","type":"INT","links":null}],"title":"[16] 取图尺寸","properties":{"Node name for S&R":"GetImageSize+","aux_id":"cubiq/ComfyUI_essentials","ver":"9d9f4bedfc9f0321c19faf71855e228c93bd0dc9","cnr_id":"comfyui_essentials","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.2"}},"color":"#233","bgcolor":"#355"},{"id":42,"type":"MarkdownNote","pos":[-1797.7773520085568,-197.49461648943804],"size":[1102,1100],"flags":{"collapsed":false},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"[42] 使用说明","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["# Krea2_画稿上色(krea2edit编辑式·破限全开·约4-6分钟)\n① [7] 载入画稿 ② [17] 改上色指令里的色彩段 ③ 跑(约4-6分钟)\ndenoise=1.0/CFG1/10步、grounding_px=0、ref_boost=4 是设计值勿动;破限链 Mystic@2.0 是审查解锁门槛(实测),低于1.0指令不生效。\n\n## 两种模式\n- **模式A·文字描述色彩(默认)**:[46]保持旁路(紫色),色彩全写在 [17] 指令里\n- **模式B·参考图取色**:[46]+[47] **两节点一起**取消旁路(Ctrl+B 切回)+换成你的彩色参考图,指令色彩段可简写\n  (image_b 语义=第二主体参考,取色效果属实验性;无效则回模式A)\n\n## 上色指令骨架(照抄改色彩段)\n为这张画稿完整上色:{色彩段:她的头发呈__色,服装为__色,背景为__色调};\n保留画稿的全部轮廓线条与细节,线条清晰不丢失;\n她的人物身份、姿态与构图保持与原图完全一致。\n\n## 画稿类型适配(按需插一句)\n- 素描稿:色彩段后加「参考原图的明暗关系上色,保留明暗体积感」\n- 半成品色稿:加「已上色区域保持原色不变,仅补全留白区域」\n- 裸露画稿:色彩段正常写肤色/场景色(破限链已兜审查)\n\n## 禁忌\n1. 否定句(「不要改变线条」×→「保留线条」✓) 2. 色彩含糊(「好看的配色」×→具体色名✓)\n3. 叠加其他编辑(上色+改姿势=两件事拆两次跑)\n\n## 出问题看 runbook\n同目录 runbook_画稿上色_错误应对.md:线稿崩→ref_boost 阶梯;色彩没进→查 Mystic@2.0;完全没编辑→查三LoRA配比(identity@1.0/Mystic@2.0/pussy@0.15)"],"widgets_values_named":{"text":"# Krea2_画稿上色(krea2edit编辑式·破限全开·约4-6分钟)\n① [7] 载入画稿 ② [17] 改上色指令里的色彩段 ③ 跑(约4-6分钟)\ndenoise=1.0/CFG1/10步、grounding_px=0、ref_boost=4 是设计值勿动;破限链 Mystic@2.0 是审查解锁门槛(实测),低于1.0指令不生效。\n\n## 两种模式\n- **模式A·文字描述色彩(默认)**:[46]保持旁路(紫色),色彩全写在 [17] 指令里\n- **模式B·参考图取色**:[46]+[47] **两节点一起**取消旁路(Ctrl+B 切回)+换成你的彩色参考图,指令色彩段可简写\n  (image_b 语义=第二主体参考,取色效果属实验性;无效则回模式A)\n\n## 上色指令骨架(照抄改色彩段)\n为这张画稿完整上色:{色彩段:她的头发呈__色,服装为__色,背景为__色调};\n保留画稿的全部轮廓线条与细节,线条清晰不丢失;\n她的人物身份、姿态与构图保持与原图完全一致。\n\n## 画稿类型适配(按需插一句)\n- 素描稿:色彩段后加「参考原图的明暗关系上色,保留明暗体积感」\n- 半成品色稿:加「已上色区域保持原色不变,仅补全留白区域」\n- 裸露画稿:色彩段正常写肤色/场景色(破限链已兜审查)\n\n## 禁忌\n1. 否定句(「不要改变线条」×→「保留线条」✓) 2. 色彩含糊(「好看的配色」×→具体色名✓)\n3. 叠加其他编辑(上色+改姿势=两件事拆两次跑)\n\n## 出问题看 runbook\n同目录 runbook_画稿上色_错误应对.md:线稿崩→ref_boost 阶梯;色彩没进→查 Mystic@2.0;完全没编辑→查三LoRA配比(identity@1.0/Mystic@2.0/pussy@0.15)"},"color":"#432","bgcolor":"#653"},{"id":4,"type":"SaveImage","pos":[2443.2120424804134,336.5744506796194],"size":[429.515625,671],"flags":{"collapsed":false},"order":21,"mode":0,"inputs":[{"localized_name":"图片","name":"images","type":"IMAGE","link":1},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"[4] 保存图片","properties":{"Node name for S&R":"SaveImage","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{"filename_prefix":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["Krea2