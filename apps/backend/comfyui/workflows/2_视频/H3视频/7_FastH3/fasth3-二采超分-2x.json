{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "t2v-480p_00001_.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["1", 0]
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "fastvideo_fasth3_8step_v2_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
    }
  },
  "6": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": ["3", 0],
      "shift_video": 10.0,
      "shift_audio": 3.0
    }
  },
  "7": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["6", 0],
      "attention": "comfy kitchen attention"
    }
  },
  "8": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": ["7", 0],
      "selection": "vsa",
      "selection.keep_percent": 10.0,
      "start_percent": 0.2,
      "end_percent": 1.0,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["2", 0],
      "vae": ["5", 0]
    }
  },
  "10": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "inputs": {
      "latent": ["9", 0],
      "model_name": "minimax_h3_latent_upscaler_3d_bf16.safetensors",
      "mode": "target dimensions",
      "mode.width": 1216,
      "mode.height": 704,
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "fp16"
    }
  },
  "11": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["8", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 0.45
    }
  },
  "12": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["8", 0],
      "conditioning": ["13", 0]
    }
  },
  "13": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["4", 0],
      "vae": ["5", 0],
      "prompt": "水墨国风动画短片画面。保持原画面构图、人物与场景不变,提升清晰度、细节与线条锐度。overall_soundscape: ambient. non_diegetic_music: None.",
      "width": 1216,
      "height": 704,
      "length": 124
    }
  },
  "14": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "16": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["14", 0],
      "guider": ["12", 0],
      "sampler": ["15", 0],
      "sigmas": ["11", 0],
      "latent_image": ["22", 0]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["16", 0],
      "vae": ["5", 0]
    }
  },
  "18": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["17", 0],
      "fps": ["2", 2],
      "bit_depth": 8
    }
  },
  "19": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["18", 0],
      "filename_prefix": "fasth3-ercai-2x",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 19.0
    }
  },
  "20": {
    "class_type": "EmptyMiniMaxH3LatentAV",
    "inputs": {
      "width": 1216,
      "height": 704,
      "length": 124
    }
  },
  "21": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": ["20", 0]
    }
  },
  "22": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": ["10", 0],
      "audio_latent": ["21", 1]
    }
  }
}
