import { useMemo } from "react";
import {
  ChevronDown,
  ChevronRight,
  Folder,
  File,
  Circle,
  BookOpen,
  ScanSearch,
  FileCode,
  Package,
  LayoutGrid,
  Image,
  Mic,
  Clapperboard,
  Scissors,
  WandSparkles,
  Download,
  Database,
  FolderArchive,
  type LucideIcon,
} from "lucide-react";
import { cn } from "@/lib/utils";

/**
 * Artifact Tree Component
 *
 * Multi-level hierarchical tree:
 *   Project (highlighted when active, with ◉ marker) → Stage folder → artifact count
 *
 * Props are pure - no IPC calls inside component
 */

/**
 * Per-stage icon mapping. Each workflow stage gets a semantically meaningful icon
 * instead of a generic file icon, so the tree reads as a workflow at a glance.
 * Keys must stay in sync with STAGE_LABELS in ArtifactCenter.tsx.
 */
const STAGE_ICONS: Record<string, LucideIcon> = {
  "novel": BookOpen,            // 小说导入 → 书本
  "analysis": ScanSearch,       // 内容分析 → 分析扫描
  "script": FileCode,           // 剧本生成 → 剧本代码
  "assets": Package,            // 素材准备 → 素材包
  "storyboard": LayoutGrid,     // 分镜设计 → 分镜格
  "image": Image,               // 图像生成 → 图片
  "voice": Mic,                 // 语音合成 → 麦克风
  "production": Clapperboard,   // 视频生产 → 场记板
  "editing": Scissors,          // 剪辑编辑 → 剪辑
  "remotion": WandSparkles,     // Remotion 编排 → 编排魔法
  "export": Download,           // 导出输出 → 导出
  "backup": Database,           // 备份归档 → 归档库
  "media-library": FolderArchive, // 媒体库 → 媒体仓库
};

// Fallback for unknown stage keys (e.g. new stages not yet mapped).
const DEFAULT_STAGE_ICON: LucideIcon = FileCode;

/**
 * Resolve the icon component for a given stage key.
 */
function getStageIcon(stageId: string): LucideIcon {
  return STAGE_ICONS[stageId] ?? DEFAULT_STAGE_ICON;
}

export interface StageNode {
  /** Stage key, e.g. "novel", "script", "image" */
  id: string;
  /** Human-readable stage label, e.g. "小说导入" */
  label: string;
  /** Number of artifacts in this stage */
  count: number;
}

export interface FileTreeNode {
  path: string;
  name: string;
  type: "directory" | "file";
  children?: FileTreeNode[];
  artifactIds?: string[];
  bytes?: number;
}

export interface ArtifactTreeProps {
  /** Projects with their stage breakdown */
  projects: {
    id: string;
    name: string;
    stages: StageNode[];
    fileTree?: FileTreeNode[];
  }[];

  /** Currently active project id (for highlight + ◉ marker) */
  activeProjectId?: string | null;

  /** Currently selected stage key (highlight stage node) */
  selectedStageId?: string | null;

  /** Callback when a stage folder is clicked (used for stage filtering) */
  onStageClick?: (stageId: string) => void;

  /** Optional callback when project is clicked */
  onProjectClick?: (projectId: string) => void;

  /** Open a real project directory in the artifact list. */
  onDirectoryClick?: (path: string) => void;

  /** Reveal a physical project file in its parent directory. */
  onFileClick?: (path: string) => void;

  /** Currently opened physical directory. */
  selectedDirectoryPath?: string;

  /** Expanded state by node ID (project or stage) */
  expandedNodes?: Set<string>;

  /** Callback when expand/collapse changes */
  onExpandToggle?: (nodeId: string) => void;

  /** Custom className for root element */
  className?: string;
}

type NodeType = 'project' | 'stage' | 'directory' | 'file';

type FlatTreeNode = {
  nodeId: string;
  label: string;
  parentId: string | null;
  level: number;
  type: NodeType;
  path?: string;
  badge?: string;
};

interface TreeNodeProps {
  level: number;
  label: string;
  nodeId: string;
  hasChildren: boolean;
  icon: React.ReactNode;
  isSelected?: boolean;
  isActiveProject?: boolean;
  isExpanded?: boolean;
  onClick?: () => void;
  onExpandToggle?: () => void;
  badge?: string;
  trailing?: React.ReactNode;
  onKeyDown?: (event: React.KeyboardEvent) => void;
}

function TreeNode({
  level,
  label,
  nodeId,
  hasChildren,
  icon,
  isSelected,
  isActiveProject,
  isExpanded,
  onClick,
  onExpandToggle,
  badge,
  trailing,
  onKeyDown,
}: TreeNodeProps) {
  const paddingLeft = `${level * 14 + 8}px`;

  return (
    <div
      className={cn(
        "flex items-center gap-1 py-1.5 pr-2 hover:bg-muted/50 transition-colors cursor-pointer select-none",
        isSelected && "bg-primary/15 text-primary font-medium",
        isActiveProject && !isSelected && "bg-accent/40",
        !isSelected && !isActiveProject && "text-foreground",
      )}
      style={{ paddingLeft }}
      onClick={onClick}
      data-node-id={nodeId}
      role="treeitem"
      tabIndex={0}
      onKeyDown={onKeyDown}
    >
      {/* Expand/Collapse toggle */}
      {hasChildren ? (
        <button
          className="p-0.5 hover:bg-muted rounded shrink-0"
          onClick={(e) => {
            e.stopPropagation();
            onExpandToggle?.();
          }}
          aria-label={isExpanded ? "折叠" : "展开"}
        >
          {isExpanded ? (
            <ChevronDown className="h-3.5 w-3.5 text-muted-foreground" />
          ) : (
            <ChevronRight className="h-3.5 w-3.5 text-muted-foreground" />
          )}
        </button>
      ) : (
        <div className="w-5 shrink-0" />
      )}

      {/* Icon */}
      <div className="text-muted-foreground shrink-0">{icon}</div>

      {/* Label */}
      <span className="flex-1 text-sm truncate">{label}</span>

      {/* Trailing marker (◉ for active project) */}
      {trailing}

      {/* Badge (count) */}
      {badge && (
        <span className="text-xs text-muted-foreground bg-muted px-1.5 py-0.5 rounded shrink-0">
          {badge}
        </span>
      )}
    </div>
  );
}

export function ArtifactTree({
  projects,
  activeProjectId,
  selectedStageId,
  onStageClick,
  onProjectClick,
  onDirectoryClick,
  onFileClick,
  selectedDirectoryPath = "",
  expandedNodes = new Set(),
  onExpandToggle,
  className,
}: ArtifactTreeProps) {
  // Flatten only expanded branches so the tree mirrors the on-disk hierarchy.
  const flatNodes = useMemo(() => {
    const nodes: FlatTreeNode[] = [];

    for (const project of projects) {
      const projNodeId = `proj-${project.id}`;
      nodes.push({
        nodeId: projNodeId,
        label: project.name,
        parentId: null,
        level: 0,
        type: 'project' as const,
      });

      if (!expandedNodes.has(projNodeId)) continue;

      const fileRootId = `files__${project.id}`;
      const fileTree = project.fileTree ?? [];
      nodes.push({
        nodeId: fileRootId,
        label: "本地文件",
        parentId: projNodeId,
        level: 1,
        type: "directory",
        path: "",
        badge: fileTree.length > 0 ? String(fileTree.length) : "",
      });

      const appendFileNodes = (parentId: string, entries: FileTreeNode[], level: number) => {
        for (const entry of entries) {
          const nodeId = `file__${project.id}__${entry.path}`;
          nodes.push({
            nodeId,
            label: entry.name,
            parentId,
            level,
            type: entry.type,
            path: entry.path,
            badge: entry.type === "directory" && entry.artifactIds?.length ? String(entry.artifactIds.length) : "",
          });
          if (entry.type === "directory" && expandedNodes.has(nodeId)) {
            appendFileNodes(nodeId, entry.children ?? [], level + 1);
          }
        }
      };

      if (expandedNodes.has(fileRootId)) {
        appendFileNodes(fileRootId, fileTree, 2);
      }

      for (const stage of project.stages) {
        nodes.push({
          nodeId: `stage__${project.id}__${stage.id}`,
          label: stage.label,
          parentId: projNodeId,
          level: 1,
          type: 'stage' as const,
          badge: stage.count > 0 ? stage.count.toString() : '',
        });
      }
    }

    return nodes;
  }, [projects, expandedNodes]);

  const handleNodeClick = (node: FlatTreeNode) => {
    if (node.type === 'stage') {
      // nodeId format: stage__{projectId}__{stageId}
      const parts = node.nodeId.split('__');
      // parts[0]='stage', parts[1]=projectId, parts[2..]=stageId (rejoin in case stageId has __)
      onStageClick?.(parts.slice(2).join('__'));
    } else if (node.type === "directory") {
      onDirectoryClick?.(node.path ?? "");
    } else if (node.type === "file") {
      onFileClick?.(node.path ?? "");
    } else {
      onProjectClick?.(node.nodeId.replace('proj-', ''));
    }
  };

  const isExpanded = (nodeId: string) => expandedNodes.has(nodeId);
  const toggleExpand = (nodeId: string) => onExpandToggle?.(nodeId);

  return (
    <div className={cn("h-full overflow-y-auto scrollbar-thin py-1 pb-3", className)}>
      {flatNodes.map((node) => {
        const isProject = node.type === 'project';
        const isDirectory = node.type === "directory";
        const projectId = node.nodeId.replace('proj-', '');
        const isActiveProject = isProject && projectId === activeProjectId;
        const stageId = !isProject ? node.nodeId.split('__').slice(2).join('__') : null;
        const StageIcon = stageId !== null ? getStageIcon(stageId) : null;
        const icon = isProject
          ? <Folder className="h-4 w-4" />
          : isDirectory
            ? <Folder className="h-4 w-4" />
            : node.type === "file"
              ? <File className="h-4 w-4" />
              : StageIcon && <StageIcon className="h-4 w-4" />;
        const hasChildren = isProject || isDirectory;
        const selected = node.type === "directory" && node.path === selectedDirectoryPath;

        return (
          <TreeNode
            key={node.nodeId}
            level={node.level}
            label={node.label}
            nodeId={node.nodeId}
            hasChildren={hasChildren}
            icon={icon}
            isSelected={selected || (!isProject && !isDirectory && node.type === "stage" && stageId !== null && selectedStageId === stageId)}
            isActiveProject={isActiveProject}
            isExpanded={isExpanded(node.nodeId)}
            onClick={() => handleNodeClick(node)}
            onKeyDown={(event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                handleNodeClick(node);
              }
            }}
            onExpandToggle={() => toggleExpand(node.nodeId)}
            badge={node.badge}
            trailing={
              isActiveProject ? (
                <Circle className="h-2 w-2 fill-primary text-primary shrink-0" />
              ) : undefined
            }
          />
        );
      })}
    </div>
  );
}

export default ArtifactTree;
