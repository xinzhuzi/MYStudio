      }
    },
    "style.gongbi-track.scene": {
      "moduleId": "style.gongbi-track.scene",
      "text": "TRACK=scene: 场景为唯一视觉主角；原图已有的人物按原数量/位置/姿态/尺度保留为小型远中景叙事或尺度参照，不得肖像特写、居中海报化、前景英雄位或人物主导光线；原图无人不得新增人物；布局、比例与前中远景不变，只改工笔媒介。 结构线对齐不漂移。 场景类型句：光源方向、明暗和天气依来源场景与时段；建筑、地物的完好或破损状态依来源事实保留。",
      "required": true,
      "singletonKey": "gongbi_style_track",
      "requires": [
        "style.gongbi-base"
      ],
      "source": {
        "path": "scripts/gongbi/daojie_gongbi_restyle.py",
