    "style.gongbi-base": {
      "moduleId": "style.gongbi-base",
      "text": "美术风格底座：中式手绘，中国工笔重彩与白描线条的二维手绘游戏插画，带彩色连环画的概括造型感。细彩线勾勒轮廓与结构，线条细稳连贯；平整分层的清晰色面塑形，色面边界清晰锐利；矿物色质感鲜泽通透，多色相并陈、主次分明、饱和度适中；画面洁净平整，繁密细节处笔触交代清楚。",
      "required": true,
      "singletonKey": "gongbi_style_base",
      "source": {
        "path": "scripts/gongbi/daojie_gongbi_restyle.py",
        "sha256": "dacd5f6dcf6f449e9eb85dee05173194a9192b649520a7d29015280197ec8da9",
        "anchor": "GONGBI_STYLE_BASE_COMPACT"
      },
      "revisionSource": {
        "path": "json/qi21_bases.json",
        "revision": "2026-10-16 用户授权的 MYStudio 提示词修订；source 保留 MA 历史基线登记"
      }
    },
    "style.gongbi-track.person": {
      "moduleId": "style.gongbi-track.person",
      "text": "TRACK=person：优先 face/hair/hands/costume；~40% 工笔 + 30% key-art + 20% depth + 10% light。 人物类型句：背景和照明依来源场景与时段；衣物磨损、尘土、血痕和身体状态依来源事实保留。",
      "required": true,
      "singletonKey": "gongbi_style_track",
      "requires": [
        "style.gongbi-base"
      ],
      "source": {
        "path": "scripts/gongbi/daojie_gongbi_restyle.py",
