  "scripts": {
    "dev": "electron-vite dev --config frontend/config/electron-vite.config.ts",
    "build": "npm run build:mac",
    "build:mac": "sh ./build/packaging/build-mac.sh --arm64",
    "build:mac:install": "sh ./build/packaging/build-mac.sh --arm64 --install",
    "build:win": "node ./build/packaging/build-desktop.mjs --win",
    "build:linux": "node ./build/packaging/build-desktop.mjs --linux",
    "typecheck": "tsc --noEmit -p frontend/config/tsconfig.json",
    "lint": "eslint . --config frontend/config/eslint.cjs --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --config frontend/config/vite.config.ts",
    "remotion:versions": "node ./build/remotion/verify-versions.mjs && remotion versions",
    "remotion:bundle": "node ./build/remotion/bundle.mjs",
    "remotion:cleanup:inventory": "node ./build/remotion/cleanup-inventory.mjs",
    "remotion:worker:smoke": "electron ./build/remotion/render-worker-entry-smoke.mjs",
    "remotion:studio:probe": "MYSTUDIO_REMOTION_STUDIO_PROBE=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/studio-probe.ts",
    "remotion:smoke:shot": "MYSTUDIO_REMOTION_SHOT=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/render-shot.ts",
    "remotion:smoke:chapter": "MYSTUDIO_REMOTION_CHAPTER=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/render-chapter.ts",
    "remotion:chapter001:shots": "MYSTUDIO_SHOT_SLOTS=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/render-shot-slots.ts",
    "remotion:smoke:first-shot": "MYSTUDIO_FIRST_SHOT=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/render-first-shot.ts",
    "remotion:smoke:first-shot:clean": "MYSTUDIO_FIRST_SHOT=1 MYSTUDIO_FIRST_SHOT_MODE=a08-clean-candidate vite-node --config build/timeline/vite-node.config.ts build/remotion/render-first-shot.ts",
    "remotion:smoke:five-shot": "MYSTUDIO_REMOTION_FIVE_SHOT=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/render-five-shot.ts",
    "remotion:measure:loudness": "MYSTUDIO_REMOTION_LOUDNESS_RUNNER=1 vite-node --config build/timeline/vite-node.config.ts build/remotion/measure-loudness.ts",
    "remotion:upgrade": "node ./build/remotion/upgrade.mjs",
    "smoke:desktop": "node ./build/smoke/smoke-desktop.mjs",
    "smoke:aitoearn-upgrade": "node ./build/scripts/aitoearn-upgrade-smoke.mjs",
    "test:all": "node ./build/scripts/run-quality-gate.mjs",
    "smoke:workflow:open": "node ./build/smoke/open-workflow-smoke-app.mjs",
    "smoke:workflow:run": "node ./build/smoke/run-visible-workflow-smoke.mjs",
    "smoke:workflow:run:project": "node ./build/smoke/run-visible-workflow-smoke.mjs --real-project",
    "smoke:workflow:background": "node ./build/smoke/run-visible-workflow-smoke.mjs --background",
    "smoke:workflow:background:project": "node ./build/smoke/run-visible-workflow-smoke.mjs --background --real-project",
    "smoke:workflow:background:project:production-canvas": "node ./build/smoke/run-visible-workflow-smoke.mjs --background --real-project --production-canvas-video",
    "smoke:video-workflow": "node ./build/smoke/video-workflow-smoke.mjs",
    "smoke:video-workflow:rollback": "vite-node --config build/timeline/vite-node.config.ts build/smoke/video-workflow-runtime-rollback-smoke.ts",
    "video:final-output-qc": "node ./build/remotion/final-output-qc.mjs",
    "smoke:installed": "node ./build/packaging/install-and-smoke.mjs",
    "video:chapter001": "node ./build/chapter_video/automate-chapter001-video.mjs",
    "video:chapter001:visual-preflight": "MYSTUDIO_CHAPTER_VIDEO_VISUAL_PREFLIGHT=1 ./node_modules/.bin/vite-node --config build/timeline/vite-node.config.ts build/chapter_video/audit-visual-continuity.ts",
    "video:chapter001:probe-providers": "node ./build/chapter_video/automate-chapter001-video.mjs --probe-providers",
    "video:chapter001:probe-generation": "node ./build/chapter_video/automate-chapter001-video.mjs --probe-generation",
    "video:chapter001:continuity-pilot": "node ./build/chapter_video/automate-chapter001-video.mjs --continuity-pilot",
    "video:chapter001:continuity-full": "node ./build/chapter_video/automate-chapter001-video.mjs --continuity-full-chapter",
